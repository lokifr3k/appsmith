  "tableData": "{{\n  (inp_shipping_paste.text || \"\").split('\\n').filter(row => row.trim() !== \"\").map(row => {\n    // Split the row by any spaces or tabs\n    let tokens = row.trim().split(/[\\s\\t]+/); \n    \n    // Read from the end of the sentence to find Qty and Order No\n    let qty = parseInt(tokens[tokens.length - 3], 10) || 0; \n    let order_no = tokens[tokens.length - 4] || \"\";\n\n    return {\n      order_no: order_no.toString(),\n      qty: qty,\n      original_text: row // Keeps the raw text just in case you need to double-check it\n    };\n  })\n}}",
