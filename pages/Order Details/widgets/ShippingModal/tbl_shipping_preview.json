  "tableData": "{{\n  (function() {\n    let shipmentList = [];\n    \n    // 1. Process the Bulk PDF Paste (if there is anything in it)\n    let bulkText = inp_shipping_paste.text || \"\";\n    if (bulkText.trim() !== \"\") {\n      let bulkRows = bulkText.split('\\n')\n        .filter(row => row.trim() !== \"\")\n        .filter((row, index, self) => self.indexOf(row) === index)\n        .map(row => {\n          let tokens = row.trim().split(/[\\s\\t]+/); \n          let qty = parseInt(tokens[tokens.length - 3], 10) || 0; \n          let order_no = tokens[tokens.length - 4] || \"\";\n          return {\n            order_no: order_no.toString(),\n            qty: qty,\n            original_text: row \n          };\n        });\n      shipmentList = shipmentList.concat(bulkRows);\n    }\n\n    // 2. Process the Quick Single-Line Box (Format: OrderNo, Qty)\n    let singleText = inp_single_shipment.text || \"\";\n    if (singleText.trim() !== \"\") {\n      // Split by comma\n      let parts = singleText.split(',');\n      let order_no = (parts[0] || \"\").trim();\n      let qty = parseInt((parts[1] || \"0\").trim(), 10) || 0;\n      \n      // Only add it if an order number was actually typed\n      if (order_no !== \"\") {\n          shipmentList.push({\n            order_no: order_no,\n            qty: qty,\n            original_text: \"Manual Entry: \" + singleText\n          });\n      }\n    }\n\n    // 3. Return the combined list to the table!\n    return shipmentList;\n  })()\n}}",
