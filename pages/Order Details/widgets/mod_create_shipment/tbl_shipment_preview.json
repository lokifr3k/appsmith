  "tableData": "{{\n  (inp_shipment_paste.text || \"\").split('\\n').filter(row => row.trim() !== \"\").map(row => {\n    let cols = row.includes('\\t') ? row.split('\\t') : row.split(',');\n    let order_no = (cols[0] || \"\").trim();\n    let input_cartons = parseInt((cols[1] || \"0\").trim(), 10) || 0;\n\n    let liveOrders = get_active_orders.data || [];\n    let orderDetails = liveOrders.find(o => o.order_no === order_no);\n    \n    let size = orderDetails ? (orderDetails.item_size || \"Not Found\") : \"Not Found\";\n    let fold = orderDetails ? (orderDetails.folding_type || \"\") : \"\";\n    \n    // THE FIX: We force both sides of the search to uppercase (.toUpperCase())\n    let masterList = get_item_masters.data || [];\n    let masterRule = masterList.find(m => \n        (m.item_size || \"\").toUpperCase() === size.toUpperCase() && \n        (m.folding_type || \"\").toUpperCase() === fold.toUpperCase()\n    );\n    \n    let pcs_per_carton = masterRule ? (masterRule.pcs_per_carton || 0) : 0;\n    let target_qty = 0;\n    \n    if (pcs_per_carton > 0 && input_cartons > 0) {\n        target_qty = input_cartons * pcs_per_carton; \n    }\n\n    return {\n      order_no: order_no,\n      size: size,\n      fold: fold,\n      total_cartons: input_cartons,\n      pcs_per_box: pcs_per_carton === 0 ? \"⚠️ Missing Master Data\" : pcs_per_carton,\n      target_qty: target_qty\n    };\n  })\n}}",
