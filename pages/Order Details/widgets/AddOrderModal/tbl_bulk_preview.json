  "tableData": "{{\n  (inp_bulk_paste.text || \"\").split('\\n').filter(row => row.trim() !== \"\").map(row => {\n    let cols = row.includes('\\t') ? row.split('\\t') : row.split(',');\n    cols = cols.map(c => (c || \"\").trim());\n    \n    let details = (cols[2] || \"\").split(' ');\n    let size = (details[0] || \"\").toUpperCase();\n    \n    const twoWordColors = [\"APPLE GREEN\", \"DARK BLUE\", \"DEEP RED\", \"DARK GREY\"]; \n    let possibleTwoWord = ((details[1] || \"\") + \" \" + (details[2] || \"\")).toUpperCase();\n    \n    let color = \"\";\n    let rawLogoText = \"\";\n    \n    if (twoWordColors.includes(possibleTwoWord)) {\n        color = (details[1] || \"\") + \" \" + (details[2] || \"\"); \n        rawLogoText = details.slice(3).join(' ') || \"\"; \n    } else {\n        color = details[1] || \"\"; \n        rawLogoText = details.slice(2).join(' ') || \"\"; \n    }\n    \n    // --- THE FOLDING TYPE DETECTIVE ---\n    // List the exact keywords you use for folds\n    const foldKeywords = [\"1-PLY\", \"2-PLY\", \"3-PLY\", \"POCKET\", \"UNFOLDED\"];\n    let detectedFold = \" \";\n    let finalLogo = rawLogoText;\n\n    // Check if the logo text contains any of those fold words\n    foldKeywords.forEach(keyword => {\n        // We use a case-insensitive check\n        if (rawLogoText.toUpperCase().includes(keyword)) {\n            detectedFold = keyword;\n            // Remove the fold keyword from the logo text so it's clean!\n            // We use a regex to match it case-insensitively\n            let regex = new RegExp(keyword, \"gi\"); \n            finalLogo = finalLogo.replace(regex, \"\").trim();\n        }\n    });\n    // ----------------------------------\n    \n    let rawQtyData = (cols[3] || \"\").split(' ');\n    let cleanQty = rawQtyData[0] || 0; \n    let typedInstructions = rawQtyData.slice(1).join(' '); \n    let excelInstructions = cols[4] || \"\"; \n    \n    return {\n      order_no: cols[0] || \"\",\n      order_date: cols[1] || \"\",\n      size: size,\n      color: color.toUpperCase(), \n      folding_type: detectedFold, // Puts it in the new column!\n      logo: finalLogo.replace(/'/g, \"''\").replace(/  +/g, ' '), // Cleans up extra spaces and apostrophes\n      qty: cleanQty,\n      instructions: (typedInstructions + \" \" + excelInstructions).trim().replace(/'/g, \"''\")\n    };\n  })\n}}",
