  "searchKey": "",
  "tableData": "{{\n  (inp_bulk_paste.text || \"\").split('\\n').filter(row => row.trim() !== \"\").map(row => {\n    let cols = row.split('\\t');\n    \n    // Split the details column\n    let details = (cols[2] || \"\").split(' ');\n    \n    // SMART FIX: Separate the number from manually typed text in the Qty column\n    let rawQtyData = (cols[3] || \"\").trim().split(' ');\n    let cleanQty = rawQtyData[0] || 0; // Grabs just the number (e.g., 32000)\n    let typedInstructions = rawQtyData.slice(1).join(' '); // Grabs manually typed words (e.g., \"Urgent\")\n    let excelInstructions = cols[4] || \"\"; // Grabs anything actually in a 5th Excel column\n    \n    return {\n      order_no: cols[0] || \"\",\n      order_date: cols[1] || \"\",\n      size: details[0] || \"\",\n      color: details[1] || \"\",\n      logo: details.slice(2).join(' ') || \"\",\n      qty: cleanQty,\n      instructions: (typedInstructions + \" \" + excelInstructions).trim()\n    };\n  })\n}}",
